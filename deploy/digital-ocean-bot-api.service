[Unit]
Description=Digital Ocean Bot API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=digitaloceanbot
Group=digitaloceanbot
WorkingDirectory=/opt/digital-ocean-bot
EnvironmentFile=/etc/digital-ocean-bot/env
ExecStart=/opt/digital-ocean-bot/bin/digital-ocean-bot-api
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/digital-ocean-bot
UMask=0077

[Install]
WantedBy=multi-user.target
