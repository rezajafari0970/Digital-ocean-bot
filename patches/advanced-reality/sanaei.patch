+package controller
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/util/crypto"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+)
+
+func TestAdvancedRealityAuthScopeAndNoRestart(t *testing.T) {
+	engine, api := newAPIAuthTestEngine(t)
+	a := &ServerController{}
+	g := engine.Group("/panel/api/server")
+	g.Use(api.checkAPIAuth, api.enforceTokenScope)
+	g.GET("/advancedReality", a.advancedRealityState)
+	g.POST("/advancedReality/transition", a.advancedRealityTransition)
+	path := filepath.Join(t.TempDir(), "core.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	var posts atomic.Int32
+	srv := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == "POST" {
+			posts.Add(1)
+			b, _ := io.ReadAll(r.Body)
+			if string(b) != `{"instance":"example"}` {
+				t.Error("body changed")
+			}
+		}
+		w.Header().Set("Content-Type", "application/json")
+		io.WriteString(w, `{"instance":"example","states":[]}`)
+	})}
+	go srv.Serve(l)
+	defer srv.Close()
+	t.Setenv("XUI_ARE_SOCKET", path)
+	for _, scope := range []string{model.ApiScopeAdmin, model.ApiScopeMonitor, model.ApiScopeNodeSync} {
+		token := "are-token-" + scope
+		if e := database.GetDB().Create(&model.ApiToken{Name: scope, Token: crypto.HashTokenSHA256(token), Enabled: true, Scope: scope}).Error; e != nil {
+			t.Fatal(e)
+		}
+		r := httptest.NewRequest("POST", "/panel/api/server/advancedReality/transition", strings.NewReader(`{"instance":"example"}`))
+		r.Header.Set("Authorization", "Bearer "+token)
+		w := httptest.NewRecorder()
+		engine.ServeHTTP(w, r)
+		want := 403
+		if scope == model.ApiScopeAdmin {
+			want = 200
+		}
+		if w.Code != want {
+			t.Fatal(scope, w.Code, w.Body.String())
+		}
+	}
+	r := httptest.NewRequest("GET", "/panel/api/server/advancedReality", nil)
+	r.Header.Set("X-Requested-With", "XMLHttpRequest")
+	w := httptest.NewRecorder()
+	engine.ServeHTTP(w, r)
