@@ -0,0 +1,76 @@
+//go:build linux
+
+package realityguard
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestOwnedSocketCrashRecovery(t *testing.T) {
+	if os.Getenv("ARE_CRASH_CHILD") == "1" {
+		stop, e := StartFromEnv()
+		if e != nil {
+			fmt.Println("FAILED")
+			os.Exit(2)
+		}
+		_ = stop
+		fmt.Println("READY")
+		time.Sleep(time.Minute)
+		os.Exit(3)
+	}
+	dir := t.TempDir()
+	os.Chmod(dir, 0700)
+	path := filepath.Join(dir, "core.sock")
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, os.Args[0], "-test.run=^TestOwnedSocketCrashRecovery$")
+	cmd.Env = append(os.Environ(), "ARE_CRASH_CHILD=1", "XRAY_ARE_SOCKET="+path, "XRAY_ARE_PORTS=24445")
+	out, e := cmd.StdoutPipe()
+	if e != nil {
+		t.Fatal(e)
+	}
+	if e = cmd.Start(); e != nil {
+		t.Fatal(e)
+	}
+	defer func() { cmd.Process.Kill(); cmd.Wait() }()
+	line, e := bufio.NewReader(out).ReadString('\n')
+	if e != nil || line != "READY\n" {
+		t.Fatal("child failed", line, e)
+	}
+	if _, _, e := openControlSocket(path); e == nil {
+		t.Fatal("live owner was replaced")
+	}
+	cmd.Process.Kill()
+	cmd.Wait()
+	if _, e := os.Lstat(path); e != nil {
+		t.Fatal("test did not leave stale socket")
+	}
+	t.Setenv("XRAY_ARE_SOCKET", path)
+	t.Setenv("XRAY_ARE_PORTS", "24445")
+	stop, e := StartFromEnv()
+	if e != nil {
+		t.Fatal("owned crash recovery", e)
+	}
+	stop()
+	// A socket planted after graceful close does not match the durable inode claim.
+	foreign, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	foreign.(*net.UnixListener).SetUnlinkOnClose(false)
+	foreign.Close()
+	if _, e := StartFromEnv(); e == nil {
+		t.Fatal("foreign stale socket was removed")
+	}
+	if _, e := os.Lstat(path); e != nil {
+		t.Fatal("foreign socket disappeared")
+	}
+}
