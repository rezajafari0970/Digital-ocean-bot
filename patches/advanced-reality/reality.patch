new file mode 100644
index 0000000..9384879
--- /dev/null
+++ b/are_cancel_test.go
@@ -0,0 +1,46 @@
+package reality
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestAREServerCancellationClosesBothSides(t *testing.T) {
+	l, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	peer, e := net.Dial("tcp", l.Addr().String())
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer peer.Close()
+	incoming, e := l.Accept()
+	if e != nil {
+		t.Fatal(e)
+	}
+	target, remote := net.Pipe()
+	defer remote.Close()
+	cfg := &Config{ServerNames: map[string]bool{"example.com": true}, DialContext: func(context.Context, string, string) (net.Conn, error) { return target, nil }}
+	ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, e := Server(ctx, incoming, cfg); done <- e }()
+	select {
+	case e := <-done:
+		if !errors.Is(e, context.DeadlineExceeded) {
+			t.Fatal(e)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("REALITY cancellation leaked blocking work")
+	}
+	remote.SetReadDeadline(time.Now().Add(time.Second))
+	if _, e := remote.Read(make([]byte, 1)); e != io.EOF {
+		t.Fatal("target remained open", e)
+	}
+}
