@@ -0,0 +1,32 @@
+package database
+
+import (
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestDOBFinalMaskMigrationKeepsVerifiedFragment(t *testing.T) {
+	core := os.Getenv("DOB_NATIVE_CORE")
+	if core == "" {
+		t.Skip("DOB_NATIVE_CORE required")
+	}
+	dir := t.TempDir()
+	if err := os.Symlink(core, filepath.Join(dir, xray.GetBinaryName())); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("XUI_BIN_FOLDER", dir)
+	raw := `{"network":"xhttp","security":"reality","finalmask":{"tcp":[{"type":"fragment","settings":{"packets":"tlshello"}}]}}`
+	got, changed := stripRealityFinalmaskTcpFromStream(raw)
+	if changed || got != raw {
+		t.Fatal("verified fragment removed during migration")
+	}
+	if err := os.Remove(filepath.Join(dir, xray.GetBinaryName())); err != nil {
+		t.Fatal(err)
+	}
+	_, changed = stripRealityFinalmaskTcpFromStream(raw)
+	if !changed {
+		t.Fatal("stock guard bypassed without verified core")
+	}
+}
