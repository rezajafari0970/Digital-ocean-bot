diff --git a/internal/xray/dob_finalmask.go b/internal/xray/dob_finalmask.go
new file mode 100644
index 0000000..231b0ee
--- /dev/null
+++ b/internal/xray/dob_finalmask.go
@@ -0,0 +1,61 @@
+package xray
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"os/exec"
+	"sync"
+	"time"
+)
+
+var dobCapabilityCache struct {
+	sync.Mutex
+	path      string
+	size      int64
+	mod       time.Time
+	checked   time.Time
+	supported bool
+}
+
+// SupportsRealityFragment keeps the stock guard for every unverified core or mask.
+func SupportsRealityFragment(stream map[string]any) bool {
+	if stream["security"] != "reality" {
+		return false
+	}
+	fm, ok := stream["finalmask"].(map[string]any)
+	if !ok {
+		return false
+	}
+	masks, ok := fm["tcp"].([]any)
+	if !ok || len(masks) == 0 {
+		return false
+	}
+	for _, v := range masks {
+		m, ok := v.(map[string]any)
+		if !ok || m["type"] != "fragment" {
+			return false
+		}
+	}
+	binary := GetBinaryPath()
+	stat, err := os.Stat(binary)
+	if err != nil || !stat.Mode().IsRegular() {
+		return false
+	}
+	dobCapabilityCache.Lock()
+	defer dobCapabilityCache.Unlock()
+	c := &dobCapabilityCache
+	if c.path == binary && c.size == stat.Size() && c.mod.Equal(stat.ModTime()) && time.Since(c.checked) < 5*time.Second {
+		return c.supported
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	raw, err := exec.CommandContext(ctx, binary, "dob-capabilities").Output()
+	var caps struct {
+		Schema   int  `json:"schema"`
+		Fragment bool `json:"reality_finalmask_fragment"`
+	}
+	supported := err == nil && len(raw) < 4096 && json.Unmarshal(raw, &caps) == nil && caps.Schema == 1 && caps.Fragment
+	c.path, c.size, c.mod, c.checked, c.supported = binary, stat.Size(), stat.ModTime(), time.Now(), supported
+	return supported
+}
