+package service
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"github.com/mhsanaei/3x-ui/v3/internal/xray"
+)
+
+func TestDOBFinalMaskNativePersistence(t *testing.T) {
+	core := os.Getenv("DOB_NATIVE_CORE")
+	if core == "" {
+		t.Skip("DOB_NATIVE_CORE required")
+	}
+	dir := t.TempDir()
+	if err := os.Symlink(core, filepath.Join(dir, xray.GetBinaryName())); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("XUI_BIN_FOLDER", dir)
+	setupConflictDB(t)
+	stream := realityFinalMaskStream
+	in := &model.Inbound{Tag: "dob-native-fragment", Enable: true, Listen: "127.0.0.1", Port: 44302, Protocol: model.VLESS, StreamSettings: stream, Settings: `{"clients":[],"decryption":"none"}`}
+	svc := &InboundService{}
+	created, _, err := svc.AddInbound(in)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var saved model.Inbound
+	if err = database.GetDB().First(&saved, created.Id).Error; err != nil {
+		t.Fatal(err)
+	}
+	var observed map[string]any
+	if json.Unmarshal([]byte(saved.StreamSettings), &observed) != nil || !xray.SupportsRealityFragment(observed) {
+		t.Fatal("native readback lost fragment")
+	}
+	cfg, err := (&XrayService{}).GetXrayConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, v := range cfg.InboundConfigs {
+		if v.Tag != in.Tag {
+			continue
+		}
+		found = true
+		var s map[string]any
+		if json.Unmarshal(v.StreamSettings, &s) != nil || s["finalmask"] == nil {
+			t.Fatal("runtime generation stripped fragment")
+		}
+	}
+	if !found {
+		t.Fatal("runtime inbound absent")
+	}
+	if err = os.Remove(filepath.Join(dir, xray.GetBinaryName())); err != nil {
+		t.Fatal(err)
+	}
+	if validateFinalMaskRealityCombo(stream) == nil {
+		t.Fatal("unverified core accepted")
+	}
+}
+
+func TestDOBNativeRoundtripFixture(t *testing.T) {
+	core := os.Getenv("DOB_NATIVE_CORE")
+	input := os.Getenv("DOB_NATIVE_INPUT")
+	output := os.Getenv("DOB_NATIVE_OUTPUT")
+	if core == "" || input == "" || output == "" {
+		t.Skip("native roundtrip environment required")
+	}
+	dir := t.TempDir()
+	if err := os.Symlink(core, filepath.Join(dir, xray.GetBinaryName())); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("XUI_BIN_FOLDER", dir)
+	setupConflictDB(t)
+	raw, err := os.ReadFile(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fixture map[string]json.RawMessage
+	if json.Unmarshal(raw, &fixture) != nil {
+		t.Fatal("fixture")
+	}
+	var inbounds []struct {
+		Listen                   string
+		Port                     int
+		Settings, StreamSettings json.RawMessage
+	}
+	if json.Unmarshal(fixture["inbounds"], &inbounds) != nil || len(inbounds) != 1 {
+		t.Fatal("inbound fixture")
+	}
+	v := inbounds[0]
+	in := &model.Inbound{Tag: "dob-native-roundtrip", Enable: true, Listen: v.Listen, Port: v.Port, Protocol: model.VLESS, Settings: string(v.Settings), StreamSettings: string(v.StreamSettings)}
+	if _, _, err = (&InboundService{}).AddInbound(in); err != nil {
+		t.Fatal("native AddInbound failed", err)
+	}
+	cfg, err := (&XrayService{}).GetXrayConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, generated := range cfg.InboundConfigs {
+		if generated.Tag != in.Tag {
+			continue
+		}
+		b, e := json.Marshal([]any{generated})
+		if e != nil {
+			t.Fatal(e)
+		}
+		fixture["inbounds"] = b
+		found = true
+	}
+	if !found {
+		t.Fatal("generated inbound missing")
+	}
+	b, err := json.Marshal(fixture)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(output, b, 0600); err != nil {
+		t.Fatal(err)
+	}
+}
