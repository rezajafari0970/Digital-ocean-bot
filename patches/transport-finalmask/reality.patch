+func TestFallbackIdleClosesBothDirections(t *testing.T) {
+	a, ap := net.Pipe()
+	b, bp := net.Pipe()
+	defer ap.Close()
+	defer bp.Close()
+	f := newFallbackCopier(a, b, 30*time.Millisecond)
+	defer f.stop()
+	done := make(chan struct{}, 2)
+	go func() { f.copy(b, a, &LimitFallback{}); done <- struct{}{} }()
+	go func() { f.copy(a, b, &LimitFallback{}); done <- struct{}{} }()
+	for i := 0; i < 2; i++ {
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Fatal("idle forwarding retained a connection")
+		}
+	}
+}
+
+type forbiddenFastPath struct{ net.Conn }
+
+func (c forbiddenFastPath) WriteTo(io.Writer) (int64, error) {
+	panic("unauthenticated splice WriterTo used")
+}
+func (c forbiddenFastPath) ReadFrom(io.Reader) (int64, error) {
+	panic("unauthenticated splice ReaderFrom used")
+}
+func TestFallbackUnidirectionalActivityAndBoundedCopy(t *testing.T) {
+	a, ap := net.Pipe()
+	b, bp := net.Pipe()
+	defer ap.Close()
+	defer bp.Close()
+	f := newFallbackCopier(a, b, 120*time.Millisecond)
+	defer f.stop()
+	done := make(chan struct{}, 2)
+	go func() { f.copy(forbiddenFastPath{b}, forbiddenFastPath{a}, &LimitFallback{}); done <- struct{}{} }()
+	go func() { f.copy(forbiddenFastPath{a}, forbiddenFastPath{b}, &LimitFallback{}); done <- struct{}{} }()
+	payload := bytes.Repeat([]byte("fallback-data"), 4096)
+	received := make(chan error, 1)
+	go func() {
+		for i := 0; i < 12; i++ {
+			v := make([]byte, len(payload))
+			if _, e := io.ReadFull(bp, v); e != nil {
+				received <- e
+				return
+			}
+			if !bytes.Equal(v, payload) {
+				received <- io.ErrUnexpectedEOF
+				return
+			}
+		}
+		received <- nil
+	}()
+	for i := 0; i < 12; i++ {
+		if _, e := ap.Write(payload); e != nil {
+			t.Fatal(e)
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+	if e := <-received; e != nil {
+		t.Fatal(e)
+	}
+	select {
+	case <-done:
+		t.Fatal("one-way active fallback closed")
+	default:
+	}
+	for i := 0; i < 2; i++ {
+		select {
+		case <-done:
+		case <-time.After(time.Second):
+			t.Fatal("forwarding did not expire after activity stopped")
+		}
+	}
+}
