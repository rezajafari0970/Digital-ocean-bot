+func TestServerInvalidTLSFallbackPreservesHalfCloseResponse(t *testing.T) {
+	target, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer target.Close()
+	request := []byte("GET / HTTP/1.1\r\nHost: example.test\r\n\r\n")
+	response := []byte("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+	targetDone := make(chan error, 1)
+	go func() {
+		c, e := target.Accept()
+		if e != nil {
+			targetDone <- e
+			return
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(2 * time.Second))
+		got, e := io.ReadAll(c)
+		if e == nil && !bytes.Equal(got, request) {
+			e = io.ErrUnexpectedEOF
+		}
+		if e == nil {
+			_, e = c.Write(response)
+		}
+		if tc, ok := c.(*net.TCPConn); ok {
+			tc.CloseWrite()
+		}
+		targetDone <- e
+	}()
+	listener, e := net.Listen("tcp", "127.0.0.1:0")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer listener.Close()
+	serverDone := make(chan error, 1)
+	go func() {
+		c, e := listener.Accept()
+		if e != nil {
+			serverDone <- e
+			return
+		}
+		c.SetDeadline(time.Now().Add(2 * time.Second))
+		_, e = Server(context.Background(), c, &Config{Type: "tcp", Dest: target.Addr().String(), DialContext: (&net.Dialer{}).DialContext})
+		serverDone <- e
+	}()
+	client, e := net.Dial("tcp", listener.Addr().String())
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer client.Close()
+	client.SetDeadline(time.Now().Add(2 * time.Second))
+	if _, e = client.Write(request); e != nil {
+		t.Fatal(e)
+	}
+	client.(*net.TCPConn).CloseWrite()
+	got, e := io.ReadAll(client)
+	if e != nil {
+		t.Fatal(e)
+	}
+	if !bytes.Equal(got, response) {
+		t.Fatalf("fallback response mismatch: %q", got)
+	}
+	if e = <-targetDone; e != nil {
+		t.Fatal(e)
+	}
+	select {
+	case e = <-serverDone:
+		if e == nil {
+			t.Fatal("invalid handshake was accepted")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("fallback server did not exit")
+	}
+}
