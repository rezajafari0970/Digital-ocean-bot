+func TestFallbackAdmissionLimitAndExpiredSlotRelease(t *testing.T) {
+	slots := make(chan struct{}, 1)
+	makeCopy := func() (*fallbackCopier, net.Conn, net.Conn) {
+		a, ap := net.Pipe()
+		b, bp := net.Pipe()
+		f := newFallbackCopier(a, b, 25*time.Millisecond)
+		f.slots = slots
+		t.Cleanup(func() { f.stop(); a.Close(); ap.Close(); b.Close(); bp.Close() })
+		return f, ap, bp
+	}
+	first, _, _ := makeCopy()
+	if !first.admit() {
+		t.Fatal("first fallback refused")
+	}
+	if !first.admit() || len(slots) != 1 {
+		t.Fatal("directions acquired duplicate slots")
+	}
+	first.touch()
+	second, _, _ := makeCopy()
+	done := make(chan error, 1)
+	go func() { _, e := second.copy(second.target, second.client, &LimitFallback{}); done <- e }()
+	select {
+	case e := <-done:
+		if e == nil {
+			t.Fatal("over-limit fallback accepted")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("fallback limit blocked waiting for a slot")
+	}
+	<-first.done
+	first.stop()
+	first.stop()
+	if len(slots) != 0 {
+		t.Fatal("expired fallback slot leaked")
+	}
+	third, _, _ := makeCopy()
+	if !third.admit() {
+		t.Fatal("released slot not reusable")
+	}
+}
