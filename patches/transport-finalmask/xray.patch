diff --git a/proxy/trojan/dob_fragment_test.go b/proxy/trojan/dob_fragment_test.go
new file mode 100644
index 0000000..3898711
--- /dev/null
+++ b/proxy/trojan/dob_fragment_test.go
@@ -0,0 +1,88 @@
+package trojan
+
+import (
+	"bytes"
+	"io"
+	"net"
+	"strings"
+	"testing"
+	"testing/iotest"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+func TestDOBTrojanFragmentedAuthentication(t *testing.T) {
+	key := strings.Repeat("a", 56)
+	payload := []byte{1, 1, 127, 0, 0, 1, 1, 187, 13, 10, 0, 255}
+	wire := append([]byte(key+"\r\n"), payload...)
+	for split := 1; split < len(wire); split++ {
+		for _, reader := range []io.Reader{
+			io.MultiReader(bytes.NewReader(wire[:split]), bytes.NewReader(wire[split:])),
+			iotest.OneByteReader(bytes.NewReader(wire)),
+			iotest.DataErrReader(bytes.NewReader(wire)),
+		} {
+			b := buf.New()
+			n, err := readAuthenticationPrefix(b, reader)
+			if err != nil || n < 58 {
+				b.Release()
+				t.Fatalf("split %d: %d %v", split, n, err)
+			}
+			v := new(Validator)
+			user := &protocol.MemoryUser{Account: &MemoryAccount{Key: []byte(key)}}
+			if err := v.Add(user); err != nil {
+				t.Fatal(err)
+			}
+			if v.Get(hexString(b.BytesTo(56))) != user {
+				t.Fatal("valid credential lost")
+			}
+			wrong := new(Validator)
+			if wrong.Get(hexString(b.BytesTo(56))) != nil {
+				t.Fatal("unknown credential accepted")
+			}
+			got := append([]byte(nil), b.Bytes()...)
+			b.Release()
+			rest, err := io.ReadAll(reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(append(got, rest...), wire) {
+				t.Fatalf("data lost at split %d", split)
+			}
+		}
+	}
+}
+
+func TestDOBTrojanPrefixFallbackAndDeadline(t *testing.T) {
+	for _, wire := range []string{"GET / HTTP/1.1\r\n\r\n", strings.Repeat("a", 56) + "\rX"} {
+		reader := iotest.OneByteReader(strings.NewReader(wire))
+		b := buf.New()
+		n, err := readAuthenticationPrefix(b, reader)
+		if err != nil || n == 0 {
+			t.Fatalf("fallback failed: %d %v", n, err)
+		}
+		got := append([]byte(nil), b.Bytes()...)
+		b.Release()
+		rest, _ := io.ReadAll(reader)
+		if string(append(got, rest...)) != wire {
+			t.Fatal("fallback data lost")
+		}
+	}
