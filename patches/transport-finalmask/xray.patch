+package fragment
+
+import (
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestFragmentHalfClosePreservesReadAndMask(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	peerCh := make(chan net.Conn, 1)
+	go func() { c, _ := listener.Accept(); peerCh <- c }()
+	raw, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer raw.Close()
+	peer := <-peerCh
+	if peer == nil {
+		t.Fatal("accept")
+	}
+	defer peer.Close()
+	deadline := time.Now().Add(3 * time.Second)
+	raw.SetDeadline(deadline)
+	peer.SetDeadline(deadline)
+	wrapped, err := NewConnServer(&Config{PacketsFrom: 0, PacketsTo: 1, LengthsMin: []int64{2}, LengthsMax: []int64{2}, DelaysMin: []int64{0}, DelaysMax: []int64{0}, MaxSplitMin: 2, MaxSplitMax: 2}, raw, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := wrapped.(*fragmentConn)
+	if c.Splice() {
+		t.Fatal("server mask bypassed")
+	}
+	record := []byte{22, 3, 3, 0, 6, 1, 2, 3, 4, 5, 6}
+	done := make(chan error, 1)
+	go func() {
+		_, e := c.Write(record)
+		if e == nil {
+			e = c.CloseWrite()
+		}
+		done <- e
+	}()
+	got, err := io.ReadAll(peer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != len(record)+5 {
+		t.Fatalf("TLS record was not split: %d", len(got))
+	}
+	if err = <-done; err != nil {
+		t.Fatal(err)
+	}
+	go func() { peer.Write([]byte("reply")); peer.(*net.TCPConn).CloseWrite() }()
+	reply, err := io.ReadAll(c)
+	if err != nil || string(reply) != "reply" {
+		t.Fatal("read side closed", err)
+	}
+}
+func TestFragmentHalfCloseUnsupportedDoesNotClose(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	c := &fragmentConn{Conn: a}
+	if !errors.Is(c.CloseWrite(), errors.ErrUnsupported) {
+		t.Fatal("unsupported half-close hidden")
+	}
+	a.SetDeadline(time.Now().Add(time.Second))
+	b.SetDeadline(time.Now().Add(time.Second))
+	go b.Write([]byte{7})
+	p := make([]byte, 1)
+	if _, err := c.Read(p); err != nil || p[0] != 7 {
+		t.Fatal("connection closed", err)
+	}
+}
