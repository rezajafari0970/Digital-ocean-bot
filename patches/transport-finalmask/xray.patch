+package http_test
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"github.com/xtls/xray-core/common"
+	. "github.com/xtls/xray-core/common/protocol/http"
+	"github.com/xtls/xray-core/common/session"
+)
+
+func TestDOBFragmentedHostNeverRoutesPartialName(t *testing.T) {
+	for _, tc := range []struct{ host, want string }{
+		{"127.0.0.1:8080", "127.0.0.1"},
+		{"Example.COM:443", "example.com"},
+		{"[2001:db8::1]:8080", "[2001:db8::1]"},
+	} {
+		request := "GET /probe HTTP/1.1\r\nX-Test: complete\r\nHost: " + tc.host + "\r\n"
+		for split := 1; split < len(request); split++ {
+			content := &session.Content{}
+			ctx := session.ContextWithContent(context.Background(), content)
+			got, err := SniffHTTP([]byte(request[:split]), ctx)
+			if err != common.ErrNoClue || got != nil {
+				t.Fatalf("host=%s split=%d prematurely resolved: %v %v", tc.host, split, got, err)
+			}
+			if len(content.Attributes) != 0 {
+				t.Fatalf("partial request committed attributes at %d", split)
+			}
+			got, err = SniffHTTP([]byte(request), ctx)
+			if err != nil || got.Domain() != tc.want {
+				t.Fatalf("host=%s split=%d complete: %v %v", tc.host, split, got, err)
+			}
+			if content.Attributes["host"] != tc.host || content.Attributes[":path"] != "/probe" {
+				t.Fatalf("missing complete attributes: %v", content.Attributes)
+			}
+		}
+	}
+}
+
+func TestDOBSniffDoesNotTreatBodyAsHost(t *testing.T) {
+	for _, ending := range []string{"\n", "\r\n"} {
+		request := strings.Join([]string{"GET / HTTP/1.1", "X-Test: a", "", "Host: attacker.invalid", ""}, ending)
+		if got, err := SniffHTTP([]byte(request), context.Background()); got != nil || err != common.ErrNoClue {
+			t.Fatalf("body host used: %v %v", got, err)
+		}
+	}
+}
