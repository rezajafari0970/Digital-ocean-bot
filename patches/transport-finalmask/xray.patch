+++ b/transport/internet/tls/certificate_snapshot_test.go
@@ -0,0 +1,69 @@
+package tls
+
+import (
+	"bytes"
+	cryptotls "crypto/tls"
+	"github.com/xtls/xray-core/common/protocol/tls/cert"
+	"sync"
+	"testing"
+)
+
+func TestCertificateReloadKeepsHandshakeSnapshotsImmutable(t *testing.T) {
+	ca, _ := cert.MustGenerate(nil, cert.CommonName("first.example"))
+	cb, _ := cert.MustGenerate(nil, cert.CommonName("second.example"))
+	first, second := ParseCertificate(ca), ParseCertificate(cb)
+	original := bytes.Clone(first.Certificate)
+	config := &Config{Certificate: []*Certificate{first}}
+	var owned *Certificate
+	var reload func(bool, bool)
+	entries := config.buildCertificateStoreWithTicker(func(c *Certificate, fn func(bool, bool)) { owned = c; reload = fn })
+	if len(entries) != 1 || reload == nil {
+		t.Fatal("reload callback missing")
+	}
+	old := entries[0].Load()
+	originalDER := bytes.Clone(old.Certificate[0])
+	get := getNewGetCertificateFunc(entries, false)
+	var readers sync.WaitGroup
+	for i := 0; i < 12; i++ {
+		readers.Add(1)
+		go func() {
+			defer readers.Done()
+			for n := 0; n < 1000; n++ {
+				c, e := get(&cryptotls.ClientHelloInfo{})
+				if e != nil || c == nil || c.Leaf == nil {
+					t.Error("incomplete handshake certificate")
+					return
+				}
+				name := c.Leaf.Subject.CommonName
+				if name != "first.example" && name != "second.example" {
+					t.Error("mixed certificate")
+					return
+				}
+				_ = len(c.OCSPStaple)
+			}
+		}()
+	}
+	for n := 0; n < 100; n++ {
+		next := first
+		if n%2 == 0 {
+			next = second
+		}
+		owned.Certificate = next.Certificate
+		owned.Key = next.Key
+		reload(true, false)
+	}
+	readers.Wait()
+	if !bytes.Equal(first.Certificate, original) {
+		t.Fatal("reload mutated input configuration")
+	}
+	if !bytes.Equal(old.Certificate[0], originalDER) || old.Leaf.Subject.CommonName != "first.example" {
+		t.Fatal("in-flight handshake certificate mutated")
+	}
+	owned.Certificate = second.Certificate
+	owned.Key = second.Key
+	reload(true, false)
+	current, e := get(&cryptotls.ClientHelloInfo{})
+	if e != nil || current.Leaf.Subject.CommonName != "second.example" {
+		t.Fatal("new handshake did not see reloaded certificate", e)
+	}
+}
