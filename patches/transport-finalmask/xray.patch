+package http
+
+import (
+	"bytes"
+	"io"
+	"strings"
+	"testing"
+	"testing/iotest"
+)
+
+func TestDOBHTTPHeaderAllFragmentBoundaries(t *testing.T) {
+	for _, request := range []bool{true, false} {
+		header := "HTTP/1.1 200 OK\r\nX-Test: response\r\n\r\n"
+		if request {
+			header = "GET /probe HTTP/1.1\r\nHost: example.com\r\nX-Test: request\r\n\r\n"
+		}
+		payload := []byte("\x00\x01\xffpayload\r\n\r\n")
+		wire := append([]byte(header), payload...)
+		for split := 1; split < len(wire); split++ {
+			reader := io.MultiReader(bytes.NewReader(wire[:split]), bytes.NewReader(wire[split:]))
+			h := new(HeaderReader)
+			if request {
+				h.ExpectThisRequest(&RequestConfig{Uri: []string{"/probe"}})
+			}
+			b, err := h.Read(reader)
+			if err != nil {
+				t.Fatalf("request=%v split=%d: %v", request, split, err)
+			}
+			var got []byte
+			if b != nil {
+				got = append(got, b.Bytes()...)
+				b.Release()
+			}
+			rest, err := io.ReadAll(reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			got = append(got, rest...)
+			if !bytes.Equal(got, payload) {
+				t.Fatalf("payload changed at split %d: %x", split, got)
+			}
+		}
+		for _, reader := range []io.Reader{iotest.OneByteReader(bytes.NewReader(wire)), iotest.DataErrReader(bytes.NewReader(wire))} {
+			h := new(HeaderReader)
+			if request {
+				h.ExpectThisRequest(&RequestConfig{Uri: []string{"/probe"}})
+			}
+			b, err := h.Read(reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var got []byte
+			if b != nil {
+				got = append(got, b.Bytes()...)
+				b.Release()
+			}
+			rest, err := io.ReadAll(reader)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(append(got, rest...), payload) {
+				t.Fatal("one-byte or terminal read lost payload")
+			}
+		}
+	}
+}
+
+func TestDOBHTTPHeaderBoundedAndValidated(t *testing.T) {
+	prefix := "GET /probe HTTP/1.1\r\nX-Pad: "
+	for _, size := range []int{maxHeaderLength - 1, maxHeaderLength, maxHeaderLength + 1, 2 * maxHeaderLength} {
+		wire := prefix + strings.Repeat("a", size-len(prefix)-4) + ENDING
+		for _, reader := range []io.Reader{strings.NewReader(wire), iotest.OneByteReader(strings.NewReader(wire))} {
+			b, err := new(HeaderReader).ExpectThisRequest(&RequestConfig{Uri: []string{"/probe"}}).Read(reader)
+			b.Release()
+			if size <= maxHeaderLength && err != nil {
+				t.Fatalf("size %d rejected: %v", size, err)
+			}
+			if size > maxHeaderLength && err != ErrHeaderToLong {
+				t.Fatalf("size %d not bounded: %v", size, err)
+			}
+		}
+	}
+	for _, wire := range []string{"GET /probe HT", "GET /probe HT\r\n\r\n", "GET /wrong HTTP/1.1\r\n\r\n"} {
+		b, err := new(HeaderReader).ExpectThisRequest(&RequestConfig{Uri: []string{"/probe"}}).Read(iotest.OneByteReader(strings.NewReader(wire)))
+		b.Release()
+		if err == nil {
+			t.Fatalf("invalid request accepted: %q", wire)
+		}
+	}
+}
