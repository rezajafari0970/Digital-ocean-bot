+++ b/transport/internet/websocket/connection_close_test.go
@@ -0,0 +1,63 @@
+package websocket
+
+import (
+	"bytes"
+	gorilla "github.com/gorilla/websocket"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"testing/iotest"
+	"time"
+)
+
+func closeFixture(t *testing.T, payload []byte, code int) *gorilla.Conn {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, e := (&gorilla.Upgrader{}).Upgrade(w, r, nil)
+		if e != nil {
+			return
+		}
+		defer c.Close()
+		if e = c.WriteMessage(gorilla.BinaryMessage, payload); e != nil {
+			return
+		}
+		_ = c.WriteControl(gorilla.CloseMessage, gorilla.FormatCloseMessage(code, ""), time.Now().Add(time.Second))
+	}))
+	t.Cleanup(server.Close)
+	c, _, e := gorilla.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http"), nil)
+	if e != nil {
+		t.Fatal(e)
+	}
+	t.Cleanup(func() { c.Close() })
+	return c
+}
+
+func TestNormalClosePreservesCompleteResponse(t *testing.T) {
+	payload := bytes.Repeat([]byte("complete-response-"), 8192)
+	for i := 0; i < 20; i++ {
+		conn := closeFixture(t, payload, gorilla.CloseNormalClosure)
+		wrapped := NewConnection(conn, conn.RemoteAddr(), nil, 0)
+		got, e := io.ReadAll(wrapped)
+		if e != nil || !bytes.Equal(got, payload) {
+			t.Fatalf("normal close lost response: bytes=%d err=%v", len(got), e)
+		}
+	}
+}
+func TestAbnormalCloseRemainsAnError(t *testing.T) {
+	conn := closeFixture(t, []byte("partial"), gorilla.ClosePolicyViolation)
+	_, e := io.ReadAll(NewConnection(conn, conn.RemoteAddr(), nil, 0))
+	if !gorilla.IsCloseError(e, gorilla.ClosePolicyViolation) {
+		t.Fatalf("abnormal close hidden: %v", e)
+	}
+}
+func TestFrameEndRetainsBytesReturnedWithEOF(t *testing.T) {
+	conn := closeFixture(t, []byte("suffix"), gorilla.CloseNormalClosure)
+	wrapped := NewConnection(conn, conn.RemoteAddr(), iotest.DataErrReader(strings.NewReader("prefix")), 0)
+	got := make([]byte, 32)
+	n, e := wrapped.Read(got)
+	if e != nil || string(got[:n]) != "prefix" {
+		t.Fatalf("last frame bytes discarded: %q %v", got[:n], e)
+	}
+}
