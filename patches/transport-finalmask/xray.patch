+			if !valid {
+				return int64(first.Len()), nil
+			}
+		}
+		if first.Len() >= 58 {
+			return int64(first.Len()), nil
+		}
+		if err != nil {
+			return int64(first.Len()), err
+		}
+		if n == 0 {
+			return int64(first.Len()), io.ErrNoProgress
+		}
+	}
