[Unit]
Description=Read-only encrypted production backup replication and full verification
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/dob-production-offhost.py
TimeoutStartSec=65min
Nice=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
